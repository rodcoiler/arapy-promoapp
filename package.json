{
  "name": "promobox",
  "version": "1.0.0",
  "description": "PromoBox — Motor de promociones NxM para Shopify (equivalente a Rebuy/GiftBox)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "dev:local": "remix vite:dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "setup": "prisma generate && prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "shopify": "shopify"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@remix-run/node": "^2.16.6",
    "@remix-run/react": "^2.16.6",
    "@remix-run/serve": "^2.16.6",
    "@shopify/app-bridge-react": "^4.1.7",
    "@shopify/polaris": "^13.9.5",
    "@shopify/shopify-app-remix": "^3.7.4",
    "isbot": "^4.4.0",
    "prisma": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.5",
    "vite": "^5.4.21",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
